# Normalize all text to LF in the repo (scripts run cross-platform; keep diffs clean).
* text=auto eol=lf

# Derived artifacts: collapse them in diffs and exclude them from language stats.
codex-marketplace/** linguist-generated=true
opencode-dist/** linguist-generated=true
.agents/plugins/** linguist-generated=true
plugins/*/scripts/** linguist-generated=true

# Derived files regenerate and never hand-merge (scripts/derived-merge.mjs). Intake files keep both sides' lines.
plugins/*/scripts/** merge=code-ops-derived
.agents/plugins/marketplace.json merge=code-ops-derived
codex-marketplace/** merge=code-ops-derived
opencode-dist/** merge=code-ops-derived
DOCS_MANIFEST.json merge=code-ops-derived
"**/98 System/Records/intake.jsonl" merge=union

# The global contract renders from AGENTS.source.md and never hand-merges: re-run scripts/render-global-contracts.mjs.
global-contracts/AGENTS.claude.md linguist-generated=true
global-contracts/AGENTS.codex.md linguist-generated=true
global-contracts/AGENTS.grok.md linguist-generated=true
