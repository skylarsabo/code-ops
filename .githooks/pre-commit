#!/bin/sh
# Keep the tracked Codex render in lockstep with the canonical Claude source, and keep
# vendored plugins/*/scripts/ copies in lockstep with their canonical scripts/ source.
# This hook stages only derived/vendored artifacts; it never stages authored source files.
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# ---- 0. survive a transiently busy index lock -----------------------------------
# `git add` takes the index lock and dies at once when it is already held. It never
# waits. The renderer below deletes and rewrites its whole output tree, and that burst
# of file changes wakes any background git client watching the checkout — an editor or
# app integration that answers with `git diff`, which refreshes the index and holds the
# lock for a few hundred milliseconds. That window lands on the staging step often
# enough that a first commit attempt fails while an identical retry succeeds.
#
# So wait for the holder to finish. Index-lock contention is the only retried failure:
# any other error still aborts the commit, and so does a lock that never clears.
retry_on_index_lock() {
  lock_error=''
  for lock_delay in 0 1 1 1 2 3; do
    [ "$lock_delay" -eq 0 ] || sleep "$lock_delay"
    if lock_error="$("$@" 2>&1 >/dev/null)"; then
      [ -z "$lock_error" ] || printf '%s\n' "$lock_error" >&2
      return 0
    fi
    case "$lock_error" in
      *index.lock*) echo "The git index lock is busy. Waiting for the holder to finish." >&2 ;;
      *) printf '%s\n' "$lock_error" >&2; return 1 ;;
    esac
  done
  printf '%s\n' "$lock_error" >&2
  echo "The git index lock stayed busy. Another git process is holding it." >&2
  return 1
}

# ---- 0b. detect staged bytes this hook changes ----------------------------------
# The regeneration and the vendored sync can rewrite staged derived files after the author
# stamped the atlas and synced the documentation manifest. Both freshness digests then
# describe bytes that no longer match the commit, and CI fails a commit that passed locally.
# The first snapshot of the staged tree is taken only once the hook is about to do work, so a
# commit this hook skips pays nothing. A second snapshot at the end shows whether the hook
# changed anything; only then do the two freshness checks below run.
before_tree=''
snapshot_staged_tree() {
  [ -n "$before_tree" ] || before_tree="$(git write-tree)"
}

atlas_dir='code-ops-docs/98 System/Atlas'
pending_marker="$(git rev-parse --git-path code-ops-derived-pending)"

# Run the atlas gate and the documentation manifest check against the staged result. These
# checks never stamp or sync: a stamp asserts that the prose still holds, which only the
# author can judge. On failure the commit aborts and a marker file in the git directory
# makes the next attempt run the same checks even though the regenerated files are by then
# already staged and the hook would change nothing.
check_derived_freshness() {
  atlas_out="$(unset GIT_DIR GIT_WORK_TREE; node scripts/atlas-check.mjs check --atlas "$atlas_dir" --gate 2>&1)" && atlas_ok=1 || atlas_ok=0
  manifest_out="$(unset GIT_DIR GIT_WORK_TREE; node scripts/docs-manifest.mjs check 2>&1)" && manifest_ok=1 || manifest_ok=0
  if [ "$atlas_ok" -eq 1 ] && [ "$manifest_ok" -eq 1 ]; then
    rm -f "$pending_marker"
    return 0
  fi
  : >"$pending_marker"
  {
    echo "Commit aborted: the staged result fails a documentation freshness check."
    if [ -n "$before_tree" ]; then
      changed_paths="$(git diff-tree -r --name-only "$before_tree" "$(git write-tree)")"
      if [ -n "$changed_paths" ]; then
        echo "This hook changed these derived paths, and they are staged:"
        printf '%s\n' "$changed_paths" | head -n 30 | sed 's/^/  /'
        [ "$(printf '%s\n' "$changed_paths" | wc -l)" -le 30 ] || echo "  (more paths not shown)"
      else
        echo "An earlier attempt of this commit already staged the regenerated derived paths."
      fi
    fi
    [ "$atlas_ok" -eq 1 ] || { echo "atlas-check --gate:"; printf '%s\n' "$atlas_out" | grep '!!' | sed 's/^/  /'; }
    [ "$manifest_ok" -eq 1 ] || { echo "docs-manifest check:"; printf '%s\n' "$manifest_out" | tail -n 10 | sed 's/^/  /'; }
    echo "To fix it, then commit again:"
    echo "  1. Re-read the prose of each STALE atlas section. Where it still holds, stamp it:"
    stale_slugs="$(printf '%s\n' "$atlas_out" | sed -n 's/^ *!! *STALE *\([^ ][^ ]*\).*/\1/p')"
    if [ -n "$stale_slugs" ]; then
      printf '%s\n' "$stale_slugs" | while IFS= read -r slug; do
        echo "       node scripts/atlas-check.mjs stamp --atlas \"$atlas_dir\" --section $slug"
      done
    else
      echo "       (the atlas gate named no STALE section; fix what it reports above)"
    fi
    echo "  2. node scripts/docs-manifest.mjs sync"
    echo "  3. git add \"code-ops-docs/98 System\""
    echo "  4. Run git commit again."
  } >&2
  return 1
}

# ---- 0c. regenerate derived files that a merge flagged --------------------------------
# The merge driver (scripts/derived-merge.mjs) takes one side of a conflicting derived file and
# records its path, because git runs a driver before the merged tree exists. This hook sees the
# merged tree, so it regenerates the flagged files here and stages them. A failed regeneration
# restores the conflict and aborts, so a stale derived file never reaches a commit. Then the
# freshness checks run against the regenerated result.
derived_merge_pending="$(git rev-parse --git-path code-ops-derived-merge-pending)"
if [ -e "$derived_merge_pending" ]; then
  command -v node >/dev/null 2>&1 || {
    echo "node is required to regenerate merged derived files." >&2
    exit 1
  }
  # A clean automatic merge reaches here through pre-merge-commit, whose staged files miss the
  # commit. The flag has post-merge amend the merge commit.
  node scripts/derived-merge.mjs regenerate ${CODE_OPS_MERGE_COMMIT:+--amend-after} || exit 1
  check_derived_freshness || exit 1
fi

# ---- 1. sync vendored plugin copies of canonical scripts/ files -----------------
# scripts/vendored-manifest.mjs lists which canonical scripts/<file> must be byte-identical
# inside which plugins/<plugin>/scripts/<file>. A staged change to one of those canonical
# files must propagate to its vendored copies BEFORE the renderer-input check below, since
# the sync can itself stage new content under plugins/ that the codex regeneration step
# must then pick up. Skip this section entirely (no node required) when nothing under
# scripts/ is staged, so unrelated commits keep working without node installed.
if ! git diff --cached --quiet -- scripts; then
  command -v node >/dev/null 2>&1 || {
    echo "node is required to sync vendored scripts." >&2
    exit 1
  }
  manifest_root_scripts="$(node --input-type=module -e "
import { RUNTIME_SCRIPTS } from './scripts/vendored-manifest.mjs';
console.log(RUNTIME_SCRIPTS.map((e) => 'scripts/' + e.name).join('\n'));
")"
  if [ -n "$manifest_root_scripts" ] && ! git diff --cached --quiet -- $manifest_root_scripts; then
    snapshot_staged_tree
    node scripts/sync-vendored.mjs
    vendored_targets="$(node --input-type=module -e "
import { RUNTIME_SCRIPTS } from './scripts/vendored-manifest.mjs';
const out = [];
for (const e of RUNTIME_SCRIPTS) for (const p of e.plugins) out.push('plugins/' + p + '/scripts/' + e.name);
console.log(out.join('\n'));
")"
    echo "$vendored_targets" | while IFS= read -r f; do
      [ -n "$f" ] && retry_on_index_lock git add -- "$f"
    done
  fi
fi

# Both host renderers read the same canonical source, so they share one input set and one
# staleness gate. scripts/model-tiers.mjs is an input because the opencode renderer bakes
# the tier bindings into its generated MODEL_TIERS.md and opencode.json.
renderer_inputs="plugins .claude-plugin/marketplace.json scripts/build-codex-marketplace.mjs scripts/build-opencode-dist.mjs scripts/model-tiers.mjs"
renderer_paths="$renderer_inputs .agents/plugins/marketplace.json codex-marketplace opencode-dist"

# Do no work for commits unrelated to either source or generated marketplace artifacts.
if git diff --cached --quiet -- $renderer_paths; then
  exit 0
fi

# Rendering reads the working tree while a commit records the index. Refuse to mix
# staged source with a different unstaged/untracked renderer input; otherwise the
# hook could stage output for source that is absent from the commit.
#
# The vendored-sync step above only ever stages files it itself just wrote (the
# plugins/*/scripts/ copies named in the manifest) — those are staged==working-tree by
# the time we get here, so they cannot trip this refusal. Any remaining unstaged/untracked
# renderer input under plugins/ is unrelated pre-existing local state and must still refuse.
if ! git diff --quiet -- $renderer_inputs || test -n "$(git ls-files --others --exclude-standard -- $renderer_inputs)"; then
  echo "Stage or stash all host-renderer inputs before committing." >&2
  exit 1
fi

command -v node >/dev/null 2>&1 || {
  echo "node is required to render the host distributions." >&2
  exit 1
}

snapshot_staged_tree
node scripts/build-codex-marketplace.mjs
retry_on_index_lock git add -A -- .agents/plugins/marketplace.json codex-marketplace/

node scripts/build-opencode-dist.mjs
retry_on_index_lock git add -A -- opencode-dist/

# ---- 3. freshness backstop -------------------------------------------------------
# Run the checks when this hook changed staged bytes, or when an earlier attempt of this
# commit failed them (the marker). A hook that changed nothing and has no marker adds no work.
if [ -e "$pending_marker" ] || [ "$(git write-tree)" != "$before_tree" ]; then
  check_derived_freshness
fi
