{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "agent": {
    "code-ops-suite-explorer": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "code-ops-suite-implementer": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "code-ops-suite-mech-review": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "code-ops-suite-mech": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "code-ops-suite-probe": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "code-ops-suite-reviewer": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "code-ops-suite-web-researcher": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "privacy-opsec-suite-explorer": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "privacy-opsec-suite-privacy-reviewer": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "rigor-tracer": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "rigor-verifier": {
      "model": "deepseek/deepseek-v4-pro"
